PORT=8080
SUNSET_API_KEY=your-api-key-here
SUNSET_API_URL=https://staging.api.sunset.video
AI_MODEL=anthropic/claude-haiku-4-5-20251001
AI_PROVIDER=sunset

# To use your own Anthropic key instead of the Sunset proxy:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-haiku-4-5-20251001

# TTS provider: "browser" (Web Speech API, no key needed) or "sunset" (real TTS via Sunset API)
TTS_PROVIDER=browser
# TTS_VOICE_ID=          # Voice UUID from /api/v1/voices (only needed for sunset provider)
