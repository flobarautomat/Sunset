# Server port
PORT=8080

# Sunset staging API (provides chat + TTS endpoints)
SUNSET_API_URL=https://staging.api.sunset.video
SUNSET_API_KEY=your-api-key-here

# AI chat provider: "sunset" (Sunset proxy, OpenAI-compatible) or "anthropic" (direct Anthropic API)
AI_PROVIDER=sunset

# Model to use for chat completions
# Sunset provider models: anthropic/claude-sonnet-4-5-20250929, anthropic/claude-haiku-4-5-20251001,
#   openai/gpt-4o-2024-11-20, openai/gpt-4o-mini, xai/grok-2-latest
# Anthropic provider models: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001 (no prefix)
AI_MODEL=anthropic/claude-haiku-4-5-20251001

# Only needed when AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# TTS provider: "browser" (Web Speech API, works without API key) or "sunset" (real TTS via Sunset API)
TTS_PROVIDER=browser

